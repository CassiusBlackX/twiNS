+void
+Ipv4GlobalRouting::RebuildIndex()
+{
+    m_hostIndex.clear();
+    m_netIndex.clear();
+    for (auto r : m_hostRoutes)
+    {
+        m_hostIndex[r->GetDest().Get()].push_back(r);
+    }
+    for (auto r : m_networkRoutes)
+    {
+        m_netIndex[r->GetDestNetworkMask().GetPrefixLength()][r->GetDestNetwork().CombineMask(r->GetDestNetworkMask()).Get()].push_back(r);
+    }
+}
+
 void
 Ipv4GlobalRouting::RemoveRoute(uint32_t index)
+{
+    RemoveRouteUnindexed(index);
+    RebuildIndex();
+}
